DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=organice
DB_USER=organice_app
DB_PASS=organice_dev_password_2026
APP_ENV=dev
APP_URL=http://localhost:8080
SITE_NAME=Organice
# Set only if the app is NOT at the domain root, e.g. /docs when served from
# https://example.com/docs. Auto-detected when left empty.
APP_BASE=

# ---------------------------------------------------------------------------
# Machine translation (optional — leave MT_KEY empty to keep it switched off)
# ---------------------------------------------------------------------------
# The driver itself is chosen in the settings table ('mt_driver'):
#   google         Google Cloud Translation API v2. Needs an API key AND a
#                  billing account; charged per character. This is the paid
#                  Cloud API — the free "Website Translator" page widget was
#                  discontinued and has no free replacement.
#   libretranslate A self-hosted LibreTranslate. No per-character cost and
#                  nothing leaves your network, but weaker output for Thai,
#                  Japanese, Korean and Chinese.
#
# The key lives HERE and not in the settings table, because the settings table
# is editable from a web form and readable by every admin.
MT_KEY=
# Override the API endpoint. Defaults to Google's, or http://127.0.0.1:5000/translate
# for libretranslate.
MT_URL=
